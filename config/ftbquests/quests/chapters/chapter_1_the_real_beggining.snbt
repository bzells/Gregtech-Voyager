		{
			dependencies: ["3A557C43CE0F534F"]
			description: ["Gregtech requires a LOT of different materials. So, to get you prepared, this quest chapter will begin with you getting small amounts of some materials."]
			id: "6ADAC23B330B235C"
			shape: "pentagon"
			size: 3.0d
