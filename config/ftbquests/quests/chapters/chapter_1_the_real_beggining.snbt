		}
		{
			dependencies: ["665922B1E3FAA7C7"]
			description: ["Welcome to the first voltage tier, 0.5 ULV! (aka steam) This tier is unique because it uses steam machines, instead of power. It also has some other mechanics, but we will come across those as we get to them."]
			id: "4CA574760EF63553"
			subtitle: "You did 1000 years of human technologocial advancements in about an hour"
			tasks: [{
				id: "71BE5591C28A30B4"
				title: "The steam age is now!"
				type: "checkmark"
			}]
			x: -21.0d
			y: 3.5d
		}
		{
			dependencies: [
				"4CA574760EF63553"
				"1AA68223242ECD8C"
			]
			description: ["Steam is produced using boilers. These allow you to.. boil water. There are three types of boilers: &l&0the solid boiler&r, which burns solid fuels, like charcoal and coal coal, &l&1the liquid boiler&r, which burns liquids like creosote and lava, and &lthe solar boiler&r, which uses the &l&o&epower of the sun&r to boil water."]
			id: "694D21DD359391F9"
			min_required_tasks: 1
			rewards: [{
				id: "65D7AAD7DDF29DC2"
				item: "kubejs:ulv_loot_bag"
				type: "item"
			}]
			size: 1.25d
			subtitle: "Can't use a nuclear power plant yet"
			tasks: [{
				id: "126ACE72A2C937D9"
				item: {
					Count: 1
					id: "ftbfiltersystem:smart_filter"
					tag: {
						"ftbfiltersystem:filter": "or(item(gtceu:lp_steam_solid_boiler)item(gtceu:lp_steam_liquid_boiler)item(gtceu:lp_steam_solar_boiler))"
					}
				}
				title: "Any Low Pressure Boiler"
				type: "item"
			}]
			title: "Actually making steam"
			x: -24.375d
			y: 3.75d
		}
		{
			dependencies: ["22A38B844EA1BE5B"]
			description: ["You need water for all of your steam machines. This multiblock, thankfully, will make water for free!"]
