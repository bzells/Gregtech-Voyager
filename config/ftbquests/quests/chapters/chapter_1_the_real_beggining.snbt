		}
		{
			dependencies: ["694D21DD359391F9"]
			description: ["The rock breaker is basically a cobble gen in a box. All you need to do is put water and lava next to this guy, and put a piece of cobblestone in it, and you will get infinite cobblestone for free!"]
			id: "5BE328CB9E229D34"
			optional: true
